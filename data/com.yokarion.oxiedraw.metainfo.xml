<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.yokarion.oxiedraw</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>OxieDraw</name>
  <summary>Sketch, paint and illustrate</summary>
  <developer id="com.yokarion">
    <name>Yokarion</name>
  </developer>

  <description>
    <p>
      OxieDraw is a fast, clean drawing app built for low-latency painting with
      a stylus, mouse or touchscreen. It keeps the interface simple without
      giving up the features artists rely on.
    </p>
    <ul>
      <li>Layers, groups, blend modes and opacity</li>
      <li>Non-destructive adjustment layers with painted masks</li>
      <li>Parameter-driven brushes with textured grain and realistic paint</li>
      <li>Text tool with per-range styling and embedded fonts</li>
      <li>Selections, gradients, smart fill, liquify and transform</li>
      <li>Symmetry and perspective drawing guides</li>
      <li>Timelapse recording with video export</li>
    </ul>
    <p>
      OxieDraw needs a GPU with Vulkan support.
    </p>
  </description>

  <launchable type="desktop-id">com.yokarion.oxiedraw.desktop</launchable>
  <provides>
    <binary>oxiedraw</binary>
  </provides>

  <url type="homepage">https://oxiedraw.yokarion.com</url>
